#!/usr/bin/make -f
# Iris ships data + shell/python tooling; there is nothing to compile. The
# auto* overrides below exist because the repo root has a Makefile (for humans),
# and debhelper would otherwise run `make install` and fail on a target that
# deliberately does not exist.
%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:
	$(MAKE) check

override_dh_auto_install:

# This tree deliberately ships more than the .deb installs (the side-effecting
# installer/remover, docs, the live-build profile, this Makefile). List the
# leftovers rather than failing on them; what the package *must* contain is
# asserted by debian/*.install plus the `dpkg -L` step in CI. --list-missing keeps
# that visible in the build log without turning a deliberate omission into an
# error we would be tempted to paper over.
override_dh_missing:
	dh_missing --list-missing

execute_after_dh_install:
	# keep the helpers executable; nothing here should ever gain a setuid bit
	chmod 0755 debian/iris-theme/usr/share/iris/scripts/*.sh \
	           debian/iris-theme/usr/share/iris/tools/*.py

.PHONY: override_dh_auto_configure override_dh_auto_build override_dh_auto_test override_dh_auto_install override_dh_missing
