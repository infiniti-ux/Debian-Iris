#!/bin/bash
# live-build hook: bake Iris as the image's DEFAULT settings.
#
# This is the only sanctioned place where Iris writes system-wide dconf defaults.
# In a self-built image it is correct (the image is ours); on a user's machine the
# same trick would fight their own configuration, so scripts/install.sh deliberately
# does NOT do it — it uses scripts/apply-settings.sh, which is per-user and reversible.
#
# live-build runs *.chroot hooks inside the chroot as root.
#
# PREREQUISITE: the built .deb must be in the image. Put it there with:
#     make deb
#     mkdir -p config/packages.chroot
#     cp ../iris-theme_*.deb config/packages.chroot/
# Without it this hook fails loudly on purpose (an image whose defaults silently
# did not apply is worse than a build that stops).
set -euo pipefail

DEST=/etc/dconf/db/local.d
PROFILE=/etc/dconf/profile/user

install -d "$DEST"

# Translate the validated gsettings profile into a dconf system-db fragment.
python3 - <<'PY'
import os
src = "/usr/share/iris/config/gsettings/iris.gsettings"
out = {}
if not os.path.exists(src):
    raise SystemExit(f"missing {src}: is iris-theme installed in the image?")
for raw in open(src, encoding="utf-8"):
    line = raw.rstrip("\n")
    if not line.strip() or line.lstrip().startswith("#"):
        continue
    parts = line.split("\t")
    if len(parts) < 3:
        continue
    schema, key, value = parts[0].strip(), parts[1].strip(), "\t".join(parts[2:]).strip()
    out.setdefault("/" + schema.replace(".", "/") + "/", []).append(f"{key}={value}")
with open("/etc/dconf/db/local.d/01-iris", "w", encoding="utf-8") as fh:
    fh.write("# generated by live-build hook 05-iris-defaults.chroot — do not edit\n")
    for section, entries in sorted(out.items()):
        fh.write(f"\n[{section}]\n")
        for e in entries:
            fh.write(e + "\n")
PY

# Make sure the system db is consulted, without removing the local ones.
if [ -f "$PROFILE" ] && ! grep -q '^system-db:local' "$PROFILE"; then
    printf 'system-db:local\n' >>"$PROFILE"
fi
if [ ! -f "$PROFILE" ]; then
    cat > "$PROFILE" <<'PROF'
user-db:user
system-db:local
PROF
fi

dconf update
