<?xml version="1.0"?>
<!DOCTYPE metacity_theme SYSTEM "/usr/share/metacity-theme-2.0.dtd">

<metacity_theme>
  <name>Iris</name>
  <author>infiniti</author>
  <description>Aluminium OS inspired window borders for Muffin</description>
  <copyright>MIT</copyright>
  <date>2026</date>

  <frame_geometry name="normal" rounded_top_left="12" rounded_top_right="12" rounded_bottom_left="0" rounded_bottom_right="0">
    <distance name="left_width" value="1"/>
    <distance name="right_width" value="1"/>
    <distance name="left_height" value="28"/>
    <distance name="right_height" value="28"/>
    <distance name="bottom_height" value="1"/>
    <distance name="title_vertical_pad" value="4"/>

    <border left="1" right="1" top="1" bottom="1"/>

    <distance name="title_x_center_offset" value="0"/>
  </frame_geometry>

  <frame_geometry name="max" rounded_top_left="0" rounded_top_right="0" rounded_bottom_left="0" rounded_bottom_right="0">
    <distance name="left_width" value="0"/>
    <distance name="right_width" value="0"/>
    <distance name="left_height" value="0"/>
    <distance name="right_height" value="0"/>
    <distance name="bottom_height" value="0"/>
    <distance name="title_vertical_pad" value="0"/>

    <border left="0" right="0" top="0" bottom="0"/>
  </frame_geometry>

  <frame style="normal" geometry="normal"/>
  <frame style="max" geometry="max" state="max"/>

  <style class="normal" state="normal">
    <title_color value="#2c3e50"/>
    <title_font name="Sans Bold 11"/>
    <button_layout close,minimize,maximize:menu</button_layout>

    <draw_ops name="titlebar">
      <rectangle color="#e0e0e0" filled="true" x="0" y="0" width="width" height="28"/>
      <line color="#bdbdbd" x1="0" y1="27" x2="width" y2="27"/>
    </draw_ops>

    <draw_ops name="border">
      <rectangle color="#bdbdbd" filled="false" x="0" y="0" width="width" height="height"/>
    </draw_ops>
  </style>

  <style class="normal" state="active">
    <title_color value="#ffffff"/>
    <title_font name="Sans Bold 11"/>

    <draw_ops name="titlebar">
      <rectangle color="#78a0dc" filled="true" x="0" y="0" width="width" height="28"/>
      <line color="#5b8bc4" x1="0" y1="27" x2="width" y2="27"/>
    </draw_ops>

    <draw_ops name="border">
      <rectangle color="#5b8bc4" filled="false" x="0" y="0" width="width" height="height"/>
    </draw_ops>
  </style>
</metacity_theme>